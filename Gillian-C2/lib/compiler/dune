(menhir
 (modules c2_annot_parser)
 (flags --explain))

(ocamllex
 (modules c2_annot_lexer))

(library
 (name gillian_C2_compiler)
 (libraries gillian yojson irep_lib kutils goto_lib kcommons memory_model)
 (flags :standard -open Goto_lib -open Kcommons)
 (preprocess
  (pps ppx_deriving.std ppx_deriving_yojson)))

(rule
 (target cbmc_version.ml)
 (deps
  (file ../../CBMC_VERSION))
 (action
  (with-stdout-to
   %{target}
   (bash "echo let expected = \\\"$(cat %{deps})\\\""))))

(rule
 (target runtime_files.ml)
 (deps
  (source_tree ../../runtime))
 (action
  (run ocaml-crunch -s -m plain -e gil ../../runtime -o %{target})))

(rule
 (target include_files.ml)
 (deps
  (source_tree ../../includes))
 (action
  (run ocaml-crunch -s -m plain -e h ../../includes -o %{target})))
